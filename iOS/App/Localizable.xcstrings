          "stringUnit": {
            "state": "translated",
            "value": "Yeniden Adlandır"
          }
        }
      }
    },
    "Delete \"%@\"?": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" silinsin mi?"
          }
        }
      }
    },
    "Delete Collection": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyonu Sil"
          }
        }
      }
    },
    "The collection is removed from all your devices. Its clips stay in your history.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koleksiyon tüm aygıtlarından silinir. İçindeki öğeler geçmişinde kalır."
          }
        }
      }
    },
