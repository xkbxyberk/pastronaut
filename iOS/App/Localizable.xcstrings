    "Even with Full Access, nothing you type is sent anywhere. The keyboard only reads your history in your own iCloud and writes the copies you capture there.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam Erişim açıkken bile yazdıkların hiçbir yere gönderilmez. Klavye yalnızca kendi iCloud'undaki geçmişi okur ve yakaladığın kopyaları oraya yazar."
          }
        }
      }
    },
    "First copied": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk kopyalama"
          }
        }
      }
    },
    "In Shortcuts, make a shortcut with “Get Clipboard” and “Save to Pastronaut”. Add it to Back Tap or the Action button to save with one gesture.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler'de “Panoyu Al” ve “Pastronaut'a kaydet” eylemleriyle bir kestirme oluştur. Tek hareketle kaydetmek için Arkaya Dokun'a ya da Eylem düğmesine ata."
          }
        }
      }
    },
    "It is removed from all your devices.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm cihazlarından silinir."
          }
        }
      }
    },
