      }
    },
    "Text": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin"
          }
        }
      }
    },
    "Text clips sync through your private iCloud database. Clip text is end-to-end encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin öğeleri özel iCloud veritabanın üzerinden eşitlenir. Metinler uçtan uca şifrelenir."
          }
        }
      }
    },
    "There was no text to save.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilecek metin yoktu."
          }
        }
      }
    },
    "This text is too large to sync, so it was not saved.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu metin eşitlenemeyecek kadar büyük, bu yüzden kaydedilmedi."
          }
        }
      }
    },
    "To save copies without tapping the paste button, set Settings › Pastronaut › Paste from Other Apps to Allow. iOS then shows a short notice each time.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapıştır düğmesine dokunmadan kopya kaydetmek için Ayarlar › Pastronaut › Diğer Uygulamalardan Yapıştır'ı İzin Ver olarak ayarla. iOS her seferinde kısa bir bildirim gösterir."
          }
        }
      }
    },
    "Turn on Sync in Pastronaut on your Mac, or save your clipboard with the paste button.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'teki Pastronaut'ta eşitlemeyi aç ya da yapıştır düğmesiyle panonu kaydet."
          }
        }
      }
    },
    "Unknown": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmiyor"
          }
        }
      }
    },
