    },
    "Turn on Sync in Pastronaut on your Mac, or save your clipboard with the paste button.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'teki Pastronaut'ta eşitlemeyi aç ya da yapıştır düğmesiyle panonu kaydet."
          }
        }
      }
    },
    "Turn on the lock for Pastronaut": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastronaut kilidini etkinleştir"
          }
        }
      }
    },
    "Type what you copied on your Mac with a single tap on iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te kopyaladığını iPhone'da tek dokunuşla yaz."
