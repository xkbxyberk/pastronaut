      }
    },
    "Show Pinned Clips in Search": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenenleri Aramada Göster"
          }
        }
      }
    },
    "Export History": {
      "extractionState": "manual",
