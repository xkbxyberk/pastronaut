    "Shown instead of the text, and found when you search. The text itself doesn't change.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metnin yerine gösterilir ve aramada bulunur. Metnin kendisi değişmez."
          }
        }
      }
    },
