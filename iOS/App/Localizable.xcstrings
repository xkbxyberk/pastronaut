    },
    "These clips stayed on this iPhone when iCloud no longer had them (its data was deleted, or the iPhone used another account), or because Privacy keeps them here. They are sent only when you choose Upload to iCloud Again; codes and cards Privacy keeps here stay.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler iCloud'da artık olmadıklarında bu iPhone'da kaldı (iCloud verisi silindi ya da iPhone başka bir hesap kullandı) ya da Gizlilik ayarı onları burada tutuyor. Yalnızca iCloud'a Yeniden Yükle'yi seçtiğinde gönderilirler; Gizlilik'in burada tuttuğu kodlar ve kartlar kalır."
          }
        }
      }
    },
