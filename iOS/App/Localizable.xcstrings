    "Lets the keyboard save new copies and fetch the latest history from iCloud itself. Tap Pastronaut under Keyboards and turn on Allow Full Access, then open the keyboard once.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavyenin yeni kopyaları kaydetmesi ve iCloud'daki son durumu kendisi çekmesi için gerekli. Klavyeler altında Pastronaut'a dokun, Tam Erişime İzin Ver'i aç ve klavyeyi bir kez aç."
          }
        }
      }
    },
