        }
      }
    },
    "%lld unpinned items are older than %@ and will be deleted from this Mac and iCloud. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unpinned item is older than %@ and will be deleted from this Mac and iCloud. This can't be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unpinned items are older than %@ and will be deleted from this Mac and iCloud. This can't be undone."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmemiş %lld öğe %@ süresinden eski. Bu Mac'ten ve iCloud'dan silinecek; bu işlem geri alınamaz."
          }
        }
      }
    },
