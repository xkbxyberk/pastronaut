    "Clip text is stored encrypted in iCloud. Copies from password managers are never synced.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğe metinleri iCloud'da şifreli saklanır. Parola yöneticilerinden yapılan kopyalar hiç eşitlenmez."
          }
        }
      }
    },
