        }
      }
    },
    "Everything stays in your own iCloud, and the text of your clips is encrypted on this Mac before it's uploaded.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey kendi iCloud'unda kalır; öğelerin metni yüklenmeden önce bu Mac'te şifrelenir."
          }
        }
      }
    },
    "Privacy Policy": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik Politikası"
          }
        }
      }
    },
    "Shown instead of the item's first line, on all your devices.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm cihazlarında öğenin ilk satırı yerine gösterilir."
